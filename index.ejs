<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/jpg" href="favicon/favicon-32x32.png"/>
    <link href="bootstrap.min.css" rel="stylesheet" />
    <link href="style.css" rel="stylesheet" />
    <title>Applix</title>
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-xl navbar-light fixed-top hk-navbar">
        <div class="container">
          
          <a class="navbar-brand" href="/">
            <img
              class="brand-img d-inline-block"
              src="6S15AQ.tif.png"
              alt="brand"
            />
          </a>
          <a
            class="navbar-toggler"
            type="button"
            data-toggle="collapse"
            data-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
            href="javascript:void(0);"
            ><span class="feather-icon"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="feather feather-more-vertical"
              >
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="12" cy="5" r="1"></circle>
                <circle cx="12" cy="19" r="1"></circle></svg></span
          ></a>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ml-auto">
              <li class="nav-item">
                <a href="#home" class="nav-link active"><%= navbar.home %></a>
              </li>
              <li class="nav-item">
                <a href="/about" class="nav-link"><%= navbar.about %></a>
              </li>
              <li class="nav-item">
                <a href="#services" class="nav-link"><%= navbar.service %></a>
              </li>
              <li class="nav-item">
                <a href="#contact-us" class="nav-link"><%= navbar.contactUs %></a>
              </li>
              <li class="nav-item">
                <select class="lang">
                  <option value="en">EN</option>
                  <option value="fr">FR</option>
                </select>
              </li>
            </ul>
          </div>
        </div>
      </nav>
      <div class="row" style="margin-top: 72px" id="home">
        <div class="col-md-12">
          <img
            src="Asset 68.png"
            class="w-100"
            alt="cover-img"
            style="height: 134%;
            position: absolute;"
          />
          <div class="container">
            <div class="row pt-5">
            <div class="col-sm-12 col-md-6 pt-56">
              <h6 class="mb-8" style="color: #fdfdfd;"><span class="text-capitalize"><%= homespan %></span> <%= homeH6 %></h6>
              <h1 style="color: #fff;font-size: 3.5rem;letter-spacing: 2px;font-weight: 700;"><%= homeH1 %></h1>
            </div>
            <div class="col-sm-12 col-md-6">
              <img src="Asset 65.png" alt="graphic" class="w-100"/>
            </div>
          </div>
        </div>
        </div>
      </div>
    </header>
    <div class="hk-pg-wrapper" style="min-height: 215px">
      <div class="row services pt-5 pb-5" id="services">
        <div class="col-md-12">
          <div class="container">
            <h2 class="service-title mb-40"><%= services.serviceTitle %></h2>
            <div class="row">
              <div class="col-sm-12 col-md-4 mb-32">
                <div class="row">
                  <div class="col-md-12">
                    <div class="card pa-24 mb-32">
                      <img src="heartbeat.png" alt="health"/>
                      <div class="card-body pa-0 mt-16">
                        <h6 class="mb-8 heading"><%= services.health.title %></h6>
                        <b><%= services.health.subTitle %></b>
                        <ul style="list-style: circle" class="pt-8 pl-16 pr-16">
                          <%  for (let des of services.health.description){ %>
                          <li><%= des %></li>
                          <% } %>
                        </ul>
                        <div class="row">
                          <div class="col-md-12 text-right">
                            <a class="btn text-uppercase" href="/health">
                              <%= moreBtn %>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-12">
                    <div class="card pa-24">
                      <img src="running.png" alt="sport"/>
                      <div class="card-body pa-0 mt-16">
                        <h6 class="mb-8 heading"><%= services.sport.title %></h6>
                        <b><%= services.sport.subTitle %></b>
                        <ul style="list-style: circle" class="pt-8 pl-16 pr-16">
                          <%  for (let des of services.sport.description){ %>
                            <li><%= des %></li>
                            <% } %>
                        </ul>
                        <div class="row">
                          <div class="col-md-12 text-right">
                            <a class="btn text-uppercase" href="/sport"><%= moreBtn %></a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-4 mb-32">
                <div class="row">
                  <div class="col-md-12">
                    <div class="card pa-24 mb-32">
                      <img src="communicate-1.png" alt="government"/>
                      <div class="card-body pa-0 mt-16">
                        <h6 class="mb-8 heading"><%= services.government.title %></h6>
                        <div class="description">
                          <p class="mb-0">
                            <%= services.government.subTitle %>
                          </p>
                          <ul style="list-style: circle" class="pt-8 pl-16 pr-16">
                            <%  for (let des of services.government.description){ %>
                              <li><%= des %></li>
                              <% } %>
                          </ul>
                        </div>
                        <div class="row">
                          <div class="col-md-12 text-right">
                            <a class="btn text-uppercase" href="/government"
                              ><%= moreBtn %></a
                            >
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-12">
                    <div class="card pa-24">
                      <img src="stats.png" alt="banking"/>
                      <div class="card-body pa-0 mt-16">
                        <h6 class="mb-8 heading"><%= services.banking.title %></h6>
                        <p class="description">
                          <%= services.banking.description %>
                        </p>
                        <div class="row">
                          <div class="col-md-12 text-right">
                            <a class="btn text-uppercase" href="/banking"><%= moreBtn %></a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-4 mb-32">
                <div class="row">
                  <div class="col-md-12">
                    <div class="card pa-24 mb-32">
                      <img src="documents.png" alt="filing"/>
                      <div class="card-body pa-0 mt-16">
                        <h6 class="mb-8 heading"><%= services.filing.title %></h6>
                        <p class="description">
                          <%= services.filing.description %>
                        </p>
                        <!-- <b>Our offer :</b>
                        <ul
                          style="list-style: circle"
                          class="pt-8 pl-16 pr-16"
                        >
                          <li>scanning,</li>
                          <li>storage,</li>
                          <li>management,</li>
                          <li>
                            tracking of documents & electronic images as well
                            as paper information captured with our document
                            scanners.
                          </li>
                        </ul> -->
                        </p>
                        <div class="row">
                          <div class="col-md-12 text-right">
                            <a class="btn text-uppercase" href="./filing"><%= moreBtn %></a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="row tools pt-5" id="tools" style="background-color:#0a00c7;">
        
        <div class="col-md-12">
          <div class="container">
            <h2 class="tools-title mb-40"><%= tools.toolsTitle %></h2>
            <div class="row">
              <div class="col-sm-12 col-md-4">
                <div class="row">
                  <div class="col-md-12">
                    <div class="media pa-16 mb-16 d-flex align-items-center">
                      <div class="tool-img rounded-circle mr-8">
                        <div class="sm-circle rounded-circle"></div>
                        <i class="fab fa-microsoft"></i>
                      </div>

                      <div class="media-body">
                        <h6 class="mb-8">Microsoft Stack</h6>
                        <ul>
                          <li>C#</li>
                          <li>Asp.Net(Web Forms)</li>
                          <li>Asp.Net Core 2</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-12">
                    <div class="media pa-16 mb-16 d-flex align-items-center">
                      <div class="tool-img rounded-circle mr-8">
                        <div class="sm-circle rounded-circle"></div>
                        <i class="fab fa-php"></i>
                      </div>

                      <div class="media-body">
                        <h6 class="mb-8">PHP Stack</h6>
                        <ul>
                          <li>Laravel Framework</li>
                          <li>PHP (Procedural & OOP)</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-4">
                <div class="row">
                  <div class="col-md-12">
                    <div class="media pa-16 mb-16 d-flex align-items-center">
                      <div class="tool-img rounded-circle mr-8">
                        <div class="sm-circle rounded-circle"></div>
                        <i class="fab fa-java"></i>
                      </div>

                      <div class="media-body">
                        <h6 class="mb-8">Java Stack</h6>
                        <ul>
                          <li>Spring(Boot & MVC)</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-12">
                    <div class="media pa-16 mb-16 d-flex align-items-center">
                      <div class="tool-img rounded-circle mr-8">
                        <div class="sm-circle rounded-circle"></div>
                        <i class="fab fa-js"></i>
                      </div>

                      <div class="media-body">
                        <h6 class="mb-8">Java Script</h6>
                        <ul>
                          <li>Node.js</li>
                          <li>Angular</li>
                          <li>React Js</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-4">
                <div class="row">
                  <div class="col-md-12">
                    <div class="media pa-16 mb-16 d-flex align-items-center">
                      <div class="tool-img rounded-circle mr-8">
                        <div class="sm-circle rounded-circle"></div>
                        <i class="fab fa-android"></i>
                      </div>

                      <div class="media-body">
                        <h6 class="mb-8">Android Apps Development</h6>
                        <ul>
                          <li>Native Android (java)</li>
                          <li>Hybrid(React Native)</li>
                          <li>Xamarin</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-12">
                    <div class="media pa-16 mb-16 d-flex align-items-center">
                      <div class="tool-img rounded-circle mr-8">
                        <div class="sm-circle rounded-circle"></div>
                        <i class="fas fa-globe"></i>
                      </div>

                      <div class="media-body">
                        <h6 class="mb-8">Web Design Tools</h6>
                        <ul>
                          <li>HTML(5) & CSS (3)</li>
                          <li>Javascript(Jquery)</li>
                          <li>Photoshop & Illustrator</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="row contact-us" id="contact-us">
        <div class="col-md-12">
          <div class="container-fluid pa-16">
            <form class="pt-5 pb-5">
              <div class="container">
                <div class="row ml-0 mr-0">
                  <div
                    class="
                      col-md-12
                      mb-40
                      d-flex
                      justify-content-center
                      align-items-center
                    "
                  >
                    <h2 class="contact-title">
                      <span> <%= contactUs.contactUsTitle %> </span>
                    </h2>
                  </div>
                  <div class="col-xs-12 col-sm-6 col-md-3">
                    <div class="form-group">
                      <label for="name" class="mb-0"><%= contactUs.name.label %><span>*</span></label>
                      <input
                        type="text"
                        id="name"
                        placeholder="your name"
                        class="form-control transparent-input pa-0"
                      />
                      <!-- <small id="passwordHelpBlock" class="form-text text-muted">
  Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
</small> -->
                    </div>
                  </div>
                  <div class="col-xs-12 col-sm-6 col-md-3">
                    <div class="form-group">
                      <label for="email" class="mb-0"
                        ><%= contactUs.email.label %><span>*</span></label
                      >
                      <input
                        type="text"
                        id="email"
                        placeholder="your email"
                        class="form-control transparent-input pa-0"
                      />
                      <!-- <small id="passwordHelpBlock" class="form-text text-muted">
  Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
</small> -->
                    </div>
                  </div>
                  <div class="col-xs-12 col-sm-6 col-md-3">
                    <div class="form-group">
                      <label for="title" class="mb-0"
                        ><%= contactUs.title.label %><span>*</span></label
                      >
                      <input
                        type="text"
                        id="title"
                        placeholder="write title"
                        class="form-control transparent-input pa-0"
                      />
                      <!-- <small id="passwordHelpBlock" class="form-text text-muted">
  Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
</small> -->
                    </div>
                  </div>
                  <div class="col-xs-12 col-sm-6 col-md-3">
                    <div class="form-group">
                      <label for="message" class="mb-0"
                        ><%= contactUs.message.label %><span>*</span></label
                      >
                      <input
                        type="text"
                        id="message"
                        placeholder="write message"
                        class="form-control transparent-input pa-0"
                      />
                      <!-- <small id="passwordHelpBlock" class="form-text text-muted">
  Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
</small> -->
                    </div>
                  </div>
                  <div class="col-md-12 mt-16 d-flex justify-content-center">
                    <button class="btn"><%= sendBtn %></button>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
      <div class="hk-footer-wrap">
        <div class="sub-footer pt-5 pb-5">
          <div class="container">
            <div class="row">
              <div class="col-md-12 d-flex align-items-center flex-column">
                <img
              class="brand-img d-inline-block mb-16"
              src="6S15AQ.tif.png"
              alt="brand"
            />
                <p class="description">
                  <%= footerDesciption %>
                </p>
              </div>
            </div>
            <hr class="mt-24 mb-24" />
            <div class="row more-features">
              <div class="col-sm-12 col-md-4">
                <div class="card border-0 shadow-none">
                  <img src="Asset 72.png" width="48" height="48"/>
                  <div class="card-body pa-0 mt-16">
                    <h6 class="mb-8"><%= footerCol1Title %></h6>
                    <p>
                      M-Peace Plaza, Wing A, 6th Floor , KN 48 ST
                      <br/>
                      P.O Box: 71 Kigali-Rwanda
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-4">
                <div class="card border-0 shadow-none">
                  <img src="Asset 71.png" width="48" height="48"/>
                  <div class="card-body pa-0 mt-16">
                    <h6 class="mb-8"><%= footerCol2Title %></h6>
                    <p>
                      info@applix.africa
                      <br/>
                      +250 784 285 313
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-4">
                <div class="card border-0 shadow-none">
                  <img src="Asset 70.png" width="48" height="48"/>
                  <div class="card-body pa-0 mt-16">
                    <h6 class="mb-8"><%= footerCol3Title %></h6>
                    <ul class="d-flex mt-16">
                      <li><a href="https://web.facebook.com/Applix.africa"><i class="fab fa-facebook-f mr-16" style="font-size: 24px;"></i></a></li>
                      <li><a href="https://twitter.com/ApplixLtd"><i class="fab fa-twitter mr-16" style="font-size: 24px;"></i></a></li>
                      <li><a href="https://www.instagram.com/applixltd/"><i class="fab fa-instagram mr-16" style="font-size: 24px;"></i></a></li>
                      <li><a href="https://www.linkedin.com/in/applixafrica"><i class="fab fa-linkedin-in mr-16" style="font-size: 24px;"></i></a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <footer class="footer">
          <div class="row">
            <div class="col-md-12 pt-8 pb-8 text-center">
              <a href="#" class="d-inline-block btn btn-icon btn-icon-only"
                ><span class="btn-icon-wrap"
                  ><i class="fab fa-facebook-f"></i></span
              ></a>
              <a href="#" class="d-inline-block btn btn-icon btn-icon-only"
                ><span class="btn-icon-wrap"><i class="fab fa-twitter"></i></span
              ></a>
              <a href="#" class="d-inline-block btn btn-icon btn-icon-only"
                ><span class="btn-icon-wrap"
                  ><i class="fab fa-google-plus-g"></i></span
              ></a>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <script
  src="https://code.jquery.com/jquery-3.6.0.min.js"
  integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
  crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/js-cookie@rc/dist/js.cookie.min.js"></script>
  <script src="bootstrap.min.js"></script>
  <script src="main.js"></script>
  </body>
</html>
